# ─── Yandex Cloud ─────────────────────────────────────────────────────────────
YDB_ENDPOINT=grpcs://ydb.serverless.yandexcloud.net:2135
YDB_DATABASE=/ru-central1/YOUR_FOLDER/YOUR_DATABASE
YDB_SA_KEY={"id":"...","service_account_id":"...","created_at":"...","key_algorithm":"RSA_2048","public_key":"-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}

YANDEX_STORAGE_BUCKET_NAME=your-bucket-name
YANDEX_STORAGE_ACCESS_KEY=your-access-key
YANDEX_STORAGE_SECRET_KEY=your-secret-key

YANDEX_DELIVERY_TOKEN=your-delivery-token
YANDEX_DELIVERY_PLATFORM_STATION_ID=your-station-id

# ─── Платежи ──────────────────────────────────────────────────────────────────
YOOKASSA_SHOP_ID=your-shop-id
YOOKASSA_SECRET_KEY=your-secret-key

TBANK_TERMINAL_KEY=your-terminal-key
TBANK_SECRET_KEY=your-secret-key

# ─── CDEK ─────────────────────────────────────────────────────────────────────
CDEK_CLIENT_ID=your-client-id
CDEK_CLIENT_SECRET=your-client-secret

# ─── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-chat-id
TELEGRAM_WHOLESALE_CHAT_ID=your-wholesale-chat-id

# ─── SMTP (Yandex Postbox) ────────────────────────────────────────────────────
SMTP_HOST=smtp.postbox.cloud.yandex.net
SMTP_PORT=465
SMTP_USER=your-postbox-user
SMTP_PASS=your-postbox-password

# ─── Bitrix24 ─────────────────────────────────────────────────────────────────
BITRIX24_WEBHOOK_URL=https://your-domain.bitrix24.ru/rest/1/your-token/

# ─── База данных (PostgreSQL для сессий) ──────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname
